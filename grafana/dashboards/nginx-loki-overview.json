{
  "id": null,
  "uid": "nginx-loki-overview",
  "title": "Nginx Logs Overview",
  "tags": ["nginx", "loki"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "status",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "query": "label_values({job=\"nginx_access\"}, status)",
          "refId": "StatusVar"
        },
        "multi": true,
        "includeAll": true,
        "refresh": 2,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request Rate",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate({job=\"nginx_access\"}[1m]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "5xx Error Rate",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate({job=\"nginx_access\",status=~\"5..\"}[1m]))"
        }
      ]
    },
    {
      "id": 3,
      "type": "table",
      "title": "Top Paths (5m)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (path) (count_over_time({job=\"nginx_access\"} | pattern \"<_> <_> <_> \\\"<method> <path> <_>\\\" <_> <_> <_> <_> <_>\" [5m])))"
        }
      ]
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Recent Access Logs",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"nginx_access\",status=~\"$status\"}"
        }
      ]
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Nginx Error Logs",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"nginx_error\"}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Request Rate by Destination",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (destination) (rate({job=\"nginx_access\",destination=~\"$destination\"}[1m]))"
        }
      ]
    }
  ]
}
